# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Map API keys. Hold the Google Maps key out of source control.
/android/secrets.properties
/ios/Flutter/Secrets.xcconfig

# Throwaway local screenshots in the repo root (not part of the app).
/flutter_*.png

# Environment config — injected from GitHub Secrets in CI, and created locally
# from .env.example. Never commit real values. .env.example IS tracked.
.env.development
.env.staging
.env.production

# Firebase config — injected from GitHub Secrets in CI, downloaded locally from
# the Firebase console. Contains backend identifiers we keep out of git.
**/google-services.json
