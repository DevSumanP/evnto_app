# Gradle wrapper (gradlew, gradlew.bat, gradle-wrapper.jar) is committed on
# purpose so CI runners build with the exact same Gradle version.
/.gradle
/captures/
/local.properties
GeneratedPluginRegistrant.java
.cxx/

# Remember to never publicly share your keystore.
# See https://flutter.dev/to/reference-keystore
key.properties
**/*.keystore
**/*.jks

# CI-materialized service accounts (written by scripts/ci_materialize_secrets.sh).
fastlane-play-service-account.json
firebase-service-account.json

# Local copies of the service-account JSONs used to seed GitHub Secrets.
play_service_account_json.json
firebase_service_account_json.json

# Fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
fastlane/README.md
