{
    // Launch configurations for VS Code.
    //
    // Each flavor (development / staging / production) has three entries:
    // debug, profile, and release. The entry point file selects which
    // `.env.<flavor>` is loaded by `bootstrap`; the `--flavor` arg picks the
    // matching Android product flavor from android/app/build.gradle.kts.
    //
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        // ─── Development ─────────────────────────────────────────────────
        {
            "name": "tap-app (development)",
            "request": "launch",
            "type": "dart",
            "program": "lib/main_development.dart",
            "args": [
                "--flavor",
                "development",
                "--dart-define=FLAVOR=development"
            ]
        },
        {
            "name": "tap-app (development · profile)",
            "request": "launch",
            "type": "dart",
            "program": "lib/main_development.dart",
            "flutterMode": "profile",
            "args": [
                "--flavor",
                "development",
                "--dart-define=FLAVOR=development"
            ]
        },
        {
            "name": "tap-app (development · release)",
            "request": "launch",
            "type": "dart",
            "program": "lib/main_development.dart",
            "flutterMode": "release",
            "args": [
                "--flavor",
                "development",
                "--dart-define=FLAVOR=development"
            ]
        },

        // ─── Staging ─────────────────────────────────────────────────────
        {
            "name": "tap-app (staging)",
            "request": "launch",
            "type": "dart",
            "program": "lib/main_staging.dart",
            "args": [
                "--flavor",
                "staging",
                "--dart-define=FLAVOR=staging"
            ]
        },
        {
            "name": "tap-app (staging · profile)",
            "request": "launch",
            "type": "dart",
            "program": "lib/main_staging.dart",
            "flutterMode": "profile",
            "args": [
                "--flavor",
                "staging",
                "--dart-define=FLAVOR=staging"
            ]
        },
        {
            "name": "tap-app (staging · release)",
            "request": "launch",
            "type": "dart",
            "program": "lib/main_staging.dart",
            "flutterMode": "release",
            "args": [
                "--flavor",
                "staging",
                "--dart-define=FLAVOR=staging"
            ]
        },

        // ─── Production ──────────────────────────────────────────────────
        {
            "name": "tap-app (production)",
            "request": "launch",
            "type": "dart",
            "program": "lib/main_production.dart",
            "args": [
                "--flavor",
                "production",
                "--dart-define=FLAVOR=production"
            ]
        },
        {
            "name": "tap-app (production · profile)",
            "request": "launch",
            "type": "dart",
            "program": "lib/main_production.dart",
            "flutterMode": "profile",
            "args": [
                "--flavor",
                "production",
                "--dart-define=FLAVOR=production"
            ]
        },
        {
            "name": "tap-app (production · release)",
            "request": "launch",
            "type": "dart",
            "program": "lib/main_production.dart",
            "flutterMode": "release",
            "args": [
                "--flavor",
                "production",
                "--dart-define=FLAVOR=production"
            ]
        }
    ]
}
