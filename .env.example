# Environment configuration template.
#
# Copy this file to .env.development, .env.staging, and .env.production and fill
# in the real values for each. Those three files are gitignored — never commit
# them. In CI they are written from GitHub Secrets (ENV_DEVELOPMENT, etc.) by
# scripts/ci_materialize_secrets.sh before the build.

# ─── App ─────────────────────────────────────────────────────────────────────
APP_NAME=

# ─── Backend ─────────────────────────────────────────────────────────────────
# Edge Functions base. Used by Dio as the default base URL for every call.
API_BASE_URL=

# Supabase project root. Used for Auth, Storage, and Realtime.
SUPABASE_URL=

# Anon (public) API key. Sent as the `apikey` header on every request.
SUPABASE_ANON_KEY=

# ─── Network ─────────────────────────────────────────────────────────────────
API_TIMEOUT_SECONDS=30

# ─── Observability ───────────────────────────────────────────────────────────
ENABLE_LOGGING=true

# ─── PostHog (optional) ──────────────────────────────────────────────────────
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
